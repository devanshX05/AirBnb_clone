<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Bookings</title>

  <link rel="stylesheet" href="/home.css">
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-50 min-h-screen font-sans">

  <!-- Navbar -->
  <nav class="bg-[#FF5A5F] shadow-md">
    <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">

      <h1 class="text-white text-xl font-bold">
        My Bookings
      </h1>

      <a
        href="/"
        class="bg-white text-[#FF5A5F] px-5 py-2 rounded-lg font-semibold hover:bg-gray-100 transition">
        Home
      </a>

    </div>
  </nav>

  <!-- Main -->
  <main class="flex items-center justify-center px-6 py-16">

    <div class="bg-white rounded-2xl shadow-lg border border-gray-200 max-w-xl w-full p-10 text-center">

      <!-- Icon -->
      <div class="text-6xl mb-5">
        🏡
      </div>

      <!-- Heading -->
      <h2 class="text-4xl font-bold text-gray-800">
        Bookings
      </h2>

      <!-- Description -->
      <p class="text-gray-500 mt-4 text-lg leading-relaxed">
        Your confirmed bookings will appear here once you reserve a home.
      </p>

      <!-- Placeholder -->
      <div class="mt-8 bg-gray-50 border border-dashed border-gray-300 rounded-xl py-8">

        <p class="text-gray-400 text-lg">
          No bookings yet
        </p>

      </div>

      <!-- Button -->
      <a
        href="/"
        class="inline-block mt-8 bg-[#FF5A5F] text-white px-8 py-3 rounded-lg font-semibold hover:bg-red-500 transition">

        Explore Homes

      </a>

    </div>

  </main>

</body>
</html>