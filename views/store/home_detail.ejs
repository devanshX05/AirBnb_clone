<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= home.houseName %></title>

  <link rel="stylesheet" href="/home.css">
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-100 min-h-screen font-sans">

  <!-- Navbar -->
  <nav class="bg-[#FF5A5F] shadow-md">
    <div class="max-w-7xl mx-auto px-6 py-4 flex items-center gap-6 text-white font-medium">
      <a href="/" class="hover:text-gray-100 transition">Home</a>
      <a href="/bookings" class="hover:text-gray-100 transition">Bookings</a>
      <a href="/favourite_list" class="hover:text-gray-100 transition">Favourites</a>
      <a href="/index" class="hover:text-gray-100 transition">Index</a>
    </div>
  </nav>

  <!-- Main -->
  <main class="max-w-6xl mx-auto px-6 py-12">

    <!-- Page Heading -->
    <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-8 text-center mb-10">

      <h1 class="text-4xl font-bold text-gray-800">
        Home Details
      </h1>

      <p class="text-gray-500 mt-2">
        Everything you need to know about this stay.
      </p>

    </div>

    <!-- Detail Card -->
    <div class="bg-white rounded-2xl shadow-lg overflow-hidden">

      <div class="grid md:grid-cols-2">

        <!-- Image -->
        <div class="bg-gray-100 flex items-center justify-center p-6">

          <img
            src="<%= home.photo %>"
            alt="<%= home.houseName %>"
            class="w-full h-96 object-cover rounded-xl shadow">

        </div>

        <!-- Details -->
        <div class="p-8 flex flex-col">

          <h2 class="text-4xl font-bold text-gray-800 mb-6">
            <%= home.houseName %>
          </h2>

          <div class="space-y-5 text-lg text-gray-700">

            <div class="flex justify-between border-b pb-3">
              <span class="font-semibold">💰 Price</span>
              <span>₹<%= home.price %> / night</span>
            </div>

            <div class="flex justify-between border-b pb-3">
              <span class="font-semibold">📍 Location</span>
              <span><%= home.location %></span>
            </div>

            <div class="flex justify-between border-b pb-3">
              <span class="font-semibold">⭐ Rating</span>
              <span><%= home.rating %> / 5</span>
            </div>

          </div>

          <!-- Buttons -->
          <div class="mt-auto pt-10 space-y-4">

            <button onclick="openPayment('<%= home._id %>', '<%= home.price %>')"
              class="w-full bg-[#FF5A5F] text-white py-3 rounded-xl font-semibold text-lg hover:bg-red-500 transition">

              Book Now

            </button>

            <form action="/favourite_list" method="POST">

              <input
                type="hidden"
                name="homeId"
                value="<%= home._id %>">

              <button
                type="submit"
                class="w-full border-2 border-[#FF5A5F] text-[#FF5A5F] py-3 rounded-xl font-semibold text-lg hover:bg-[#FF5A5F] hover:text-white transition">

                Add to Favourites

              </button>

            </form>

          </div>

        </div>

      </div>

    </div>

    <!-- Back Button -->
    <div class="text-center mt-10">

      <a
        href="/"
        class="inline-block bg-[#FF5A5F] text-white px-8 py-3 rounded-xl font-semibold hover:bg-red-500 transition shadow">

        ← Back to Home

      </a>

    </div>

  </main>
  <!-- this is my razorpay openpayment function of javascript -->
<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<script>

async function openPayment(homeId, amount) {

    console.log("Home ID:", homeId);

    try {

        // 1. Create Razorpay order through our backend
        const response = await fetch("/payment/create-order", {
            method: "POST",
            headers: {
                "Content-Type": "application/json"
            },
            body: JSON.stringify({
                homeId: homeId
            })
        });

        const data = await response.json();

        console.log("Order response:", data);

        if (!data.success) {
            alert("Unable to create payment order.");
            return;
        }

        // 2. Razorpay Checkout configuration
        const options = {

            key: data.key_id,

            amount: data.order.amount,

            currency: data.order.currency,

            name: "Airbnb Clone",

            description: "Booking for <%= home.houseName %>",

            order_id: data.order.id,

            handler: async function (response) {

                console.log("Payment response:", response);

                // 3. Send payment details to backend
                const verifyResponse = await fetch(
                    "/payment/verify-payment",
                    {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json"
                        },
                        body: JSON.stringify({

                            razorpay_order_id:
                                response.razorpay_order_id,

                            razorpay_payment_id:
                                response.razorpay_payment_id,

                            razorpay_signature:
                                response.razorpay_signature,

                            homeId: homeId
                        })
                    }
                );

                const verifyData = await verifyResponse.json();

                console.log("Verification response:", verifyData);

                if (verifyData.success) {

                    alert("Payment successful!");

                    // Later you can redirect to booking page
                    // window.location.href = "/bookings";

                } else {

                    alert("Payment verification failed.");

                }
            },

            prefill: {
                name: "<%= user ? user.firstname : '' %>",
                email: "<%= user ? user.email : '' %>"
            },

            theme: {
                color: "#FF5A5F"
            }
        };

        // 4. Create Razorpay checkout instance
        const razorpay = new Razorpay(options);

        // 5. Open Razorpay payment window
        razorpay.open();

    } catch (error) {

        console.error("Payment error:", error);

        alert("Something went wrong while starting payment.");

    }
}

</script>
</body>
</html>