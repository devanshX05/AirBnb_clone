<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Create Account</title>

  <link rel="stylesheet" href="/home.css">
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-50 min-h-screen font-sans">

<!-- Navbar -->
<nav class="bg-[#FF5A5F] shadow-md">
  <div class="max-w-7xl mx-auto px-6 py-4 flex justify-between items-center">

    <h1 class="text-white text-xl font-bold">
      Airbnb 
    </h1>

    <a
      href="/"
      class="bg-white text-[#FF5A5F] px-5 py-2 rounded-lg font-semibold hover:bg-gray-100 transition">

      Home

    </a>

  </div>
</nav>

<!-- Main -->

<main class="flex justify-center py-12 px-4">

<div class="bg-white w-full max-w-2xl rounded-2xl shadow-xl border border-gray-200 overflow-hidden">

<!-- Header -->

<div class="bg-[#FF5A5F] text-white text-center py-8">



<h2 class="text-3xl font-bold">
Create Account
</h2>



</div>

<!-- Error Messages -->

<% if(errorMessage.length>0){ %>

<div class="mx-8 mt-8 bg-red-100 border border-red-300 rounded-xl p-4">

<ul class="list-disc list-inside text-red-700 space-y-1">

<% errorMessage.forEach(error=>{ %>

<li><%= error %></li>

<% }) %>

</ul>

</div>

<% } %>

<!-- Form -->

<form action="/signup" method="POST" class="p-8 space-y-6">

<!-- Name -->

<div class="grid md:grid-cols-2 gap-5">

<div>

<label class="block font-semibold text-gray-700 mb-2">
First Name
</label>

<input
type="text"
name="firstname"
value="<%= oldInput.firstname %>"
required
placeholder="David"
class="w-full px-4 py-3 border rounded-xl focus:ring-2 focus:ring-[#FF5A5F] focus:outline-none">

</div>

<div>

<label class="block font-semibold text-gray-700 mb-2">
Last Name
</label>

<input
type="text"
name="lastname"
value="<%= oldInput.lastname %>"
placeholder="Beckham"
class="w-full px-4 py-3 border rounded-xl focus:ring-2 focus:ring-[#FF5A5F] focus:outline-none">

</div>

</div>

<!-- Email -->

<div>

<label class="block font-semibold text-gray-700 mb-2">
Email
</label>

<input
type="email"
name="email"
value="<%= oldInput.email %>"
required
placeholder="john@example.com"
class="w-full px-4 py-3 border rounded-xl focus:ring-2 focus:ring-[#FF5A5F] focus:outline-none">

</div>

<!-- Password -->

<div class="grid md:grid-cols-2 gap-5">

<div>

<label class="block font-semibold text-gray-700 mb-2">
Password
</label>

<input
type="password"
name="password"
required
placeholder="Enter password"
class="w-full px-4 py-3 border rounded-xl focus:ring-2 focus:ring-[#FF5A5F] focus:outline-none">

</div>

<div>

<label class="block font-semibold text-gray-700 mb-2">
Confirm Password
</label>

<input
type="password"
name="confirmpassword"
required
placeholder="Confirm password"
class="w-full px-4 py-3 border rounded-xl focus:ring-2 focus:ring-[#FF5A5F] focus:outline-none">

</div>

</div>

<!-- User Type -->

<div>

<label class="block font-semibold text-gray-700 mb-4">
Register As
</label>

<div class="grid grid-cols-2 gap-4">

<label class="border rounded-xl p-4 flex items-center gap-3 cursor-pointer hover:border-[#FF5A5F]">

<input
type="radio"
name="userType"
value="guest"
checked
class="accent-[#FF5A5F]">

<div>

<p class="font-semibold">
Guest
</p>



</div>

</label>

<label class="border rounded-xl p-4 flex items-center gap-3 cursor-pointer hover:border-[#FF5A5F]">

<input
type="radio"
name="userType"
value="host"
class="accent-[#FF5A5F]">

<div>

<p class="font-semibold">
Host
</p>



</div>

</label>

</div>

</div>

<!-- Terms -->

<label class="flex items-start gap-3">

<input
type="checkbox"
required
class="mt-1 accent-[#FF5A5F]">

<span class="text-gray-600">

I agree to the

<a href="#" class="text-[#FF5A5F] hover:underline">

Terms & Conditions

</a>

</span>

</label>

<!-- Button -->

<button
type="submit"
class="w-full bg-[#FF5A5F] text-white py-3 rounded-xl font-semibold hover:bg-red-500 transition">

Create Account

</button>

<p class="text-center text-gray-500">

Already have an account?

<a
href="/login"
class="text-[#FF5A5F] font-semibold hover:underline">

Login

</a>

</p>

</form>

</div>

</main>

</body>
</html>